# Copy to .env (git ignores it) to change the tutor memory's settings. Everything is optional.

# Password for the local tutor-db Postgres in docker-compose.yml. It only listens on
# 127.0.0.1, but pick your own if you like. Set it before the first `docker compose up`:
# Postgres keeps the password it was created with.
TUTOR_DB_PASSWORD=prooflab-local

# Use any other Postgres instead of the compose service (Homebrew, or a hosted one if you
# want the same tutor memory on several machines). Overrides TUTOR_DB_PASSWORD.
# PROOFLAB_TUTOR_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Memory profile, if more than one person uses this clone.
# PROOFLAB_TUTOR_LEARNER=me
