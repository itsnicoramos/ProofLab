            "b"
          ]
        },
        {
          "op": "divides",
          "args": [
            "a",
            "c"
          ]
        }
      ]
    }
  },
  "answer": "a = 4, b = 2, c = 2",
  "mistakes": [],
  "hints": [
    "You need a to divide the product bc without dividing either factor.",
    "Try a composite a and split its factors between b and c."
  ],
  "solution": [
    "Take $a = 4$, $b = 2$, $c = 2$: $bc = 4$, so $a \\mid bc$, but $4 \\nmid 2$.",
    "The hypothesis holds and the conclusion fails, so the statement is false."
  ],
