  "mistakes": [],
  "hints": [
    "If at least two of a, b, c are even, every product ab, bc, ac is even.",
    "Now make the third number odd."
  ],
  "solution": [
    "Take $a = 1$, $b = 2$, $c = 2$: $ab = 2$, $bc = 4$, $ac = 2$ are all even.",
    "But $a$ is odd while $b$ and $c$ are even, so the conclusion fails."
  ],
