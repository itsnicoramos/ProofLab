  "title": "Disprove: n² + n + 41 is always prime",
  "prompt": "Disprove: for every integer $n \\ge 0$, $n^2 + n + 41$ is prime. Give a counterexample.",
  "answer_format": "A value like n = 5.",
  "difficulty": 2,
