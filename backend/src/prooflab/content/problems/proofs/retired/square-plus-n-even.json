  "title": "n² + n is always even",
  "prompt": "Prove: for every integer $n$, $n^2 + n$ is even.",
  "answer_format": "A structured proof: let, case, expr and witness steps (notes optional). No final answer box. Use case steps to split into possibilities.",
  "difficulty": 2,
  "tags": [
    "cases",
    "parity"
