{
  "id": "precalc.functions.domain-root-over-linear",
  "course": "precalc",
  "topic": "functions",
  "kind": "domain",
  "title": "Domain with a root and a denominator",
  "prompt": "Find the domain of $f(x) = \\dfrac{\\sqrt{x - 2}}{x - 5}$.",
  "answer_format": "Interval notation, e.g. [a, b) U (b, oo), or inequalities.",
  "difficulty": 1,
  "tags": [
    "domain"
  ],
  "data": {
    "function": "sqrt(x - 2)/(x - 5)"
  },
  "answer": "[2, 5) U (5, oo)",
  "mistakes": [],
  "hints": [
    "Two restrictions: what's under the square root can't be negative, and the denominator can't be zero."
  ],
  "solution": [
    "$x - 2 \\ge 0$ gives $x \\ge 2$.",
    "$x - 5 \\ne 0$ gives $x \\ne 5$.",
    "Domain: $[2, 5) \\cup (5, \\infty)$."
  ],
  "reference": {
    "book": "openstax-precalc2e",
    "section": "3.2 Domain and Range",
    "note": "Original problem."
  },
  "review": {
    "status": "draft"
  },
