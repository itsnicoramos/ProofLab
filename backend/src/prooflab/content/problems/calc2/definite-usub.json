  "title": "Change the limits",
  "prompt": "Evaluate $\\displaystyle \\int_0^1 2x\\,(x^2 + 1)^3\\,dx$.",
  "answer_format": "An exact number (fractions, sqrt, pi, ln ...), or 'diverges'.",
  "difficulty": 2,
  "tags": [
