{
  "id": "calc2.integrals.usub-missing-half",
  "course": "calc2",
  "topic": "integrals",
  "kind": "antiderivative",
  "title": "u-substitution",
  "prompt": "Find $\\displaystyle \\int x\\,(x^2 + 1)^3\\,dx$.",
  "answer_format": "An antiderivative in x, including + C.",
  "difficulty": 1,
  "tags": [
    "u-substitution"
  ],
  "data": {
    "integrand": "x (x^2 + 1)^3"
  },
  "answer": "(x^2 + 1)^4/8 + C",
  "mistakes": [],
  "hints": [
    "Let u = x² + 1. What is du?",
    "du = 2x dx, so x dx = du/2."
  ],
  "solution": [
    "Let $u = x^2 + 1$, so $du = 2x\\,dx$ and $x\\,dx = \\tfrac{1}{2}du$.",
    "$\\int x(x^2+1)^3\\,dx = \\tfrac12\\int u^3\\,du = \\tfrac{u^4}{8} + C = \\tfrac{(x^2+1)^4}{8} + C$."
  ],
  "reference": {
    "book": "openstax-calc2",
    "section": "1.5 Substitution",
    "note": "Original problem."
  },
  "review": {
    "status": "draft"
  },
