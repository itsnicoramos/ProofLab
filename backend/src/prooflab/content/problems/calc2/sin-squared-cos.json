{
  "id": "calc2.integrals.sin-squared-cos",
  "course": "calc2",
  "topic": "integrals",
  "kind": "antiderivative",
  "title": "A trigonometric integral",
  "prompt": "Find $\\displaystyle \\int \\sin^2 x \\cos x\\,dx$.",
  "answer_format": "An antiderivative in x, including + C.",
  "difficulty": 1,
  "tags": [
    "trig integrals",
    "u-substitution"
  ],
  "data": {
    "integrand": "sin(x)^2 cos(x)"
  },
  "answer": "sin(x)^3/3 + C",
  "mistakes": [],
  "hints": [
    "cos x dx is the derivative of sin x. Try u = sin x."
  ],
  "solution": [
    "Let $u = \\sin x$, $du = \\cos x\\,dx$.",
    "$\\int u^2\\,du = \\tfrac{u^3}{3} + C = \\tfrac{\\sin^3 x}{3} + C$."
  ],
  "reference": {
    "book": "openstax-calc2",
    "section": "3.2 Trigonometric Integrals",
    "note": "Original problem."
  },
  "review": {
    "status": "draft"
  },
  "examples": [
    {
      "name": "u = sin x",
      "submission": {
        "steps": [
          {
            "kind": "sub",
            "content": "u = sin(x)"
          },
          {
            "kind": "expr",
            "content": "int(u^2, u)"
          },
          {
            "kind": "expr",
            "content": "u^3/3 + C"
          }
        ],
        "answer": "sin^3(x)/3 + C"
      },
      "expect": {
        "status": "correct"
      }
    },
