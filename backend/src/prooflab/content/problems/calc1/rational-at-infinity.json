  "title": "Limit at infinity",
  "prompt": "Evaluate $\\displaystyle \\lim_{x \\to \\infty} \\frac{3x^2 + 1}{2x^2 - x}$.",
  "answer_format": "A number, oo, -oo, or DNE.",
  "difficulty": 1,
  "tags": [
