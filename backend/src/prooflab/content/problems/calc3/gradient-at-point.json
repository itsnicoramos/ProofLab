{
  "id": "calc3.partials.gradient-at-point",
  "course": "calc3",
  "topic": "partials",
  "kind": "gradient",
  "title": "Gradient at a point",
  "prompt": "Let $f(x, y) = x e^{y} + y^2$. Find $\\nabla f(2, 0)$.",
  "answer_format": "A vector of numbers like <a, b>.",
  "difficulty": 1,
  "tags": [
    "gradient"
  ],
  "data": {
    "function": "x e^y + y^2",
    "variables": [
      "x",
      "y"
    ],
    "at": [
      "2",
      "0"
    ]
  },
  "answer": "<1, 2>",
  "mistakes": [],
  "hints": [
    "Find ∇f as a formula first, then substitute x = 2 and y = 0."
  ],
  "solution": [
    "$\\nabla f = \\langle e^y,\\ xe^y + 2y\\rangle$.",
    "At $(2, 0)$: $\\langle e^0,\\ 2e^0 + 0\\rangle = \\langle 1, 2\\rangle$."
  ],
  "reference": {
    "book": "openstax-calc3",
    "section": "4.6 Directional Derivatives and the Gradient",
    "note": "Original problem."
  },
