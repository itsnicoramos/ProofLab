{
  "id": "calc3.partials.first-partial",
  "course": "calc3",
  "topic": "partials",
  "kind": "partial_derivative",
  "title": "A first partial derivative",
  "prompt": "Find $\\dfrac{\\partial f}{\\partial x}$ for $f(x, y) = x^3 y^2 + 4xy$.",
  "answer_format": "An expression in x and y.",
  "difficulty": 1,
  "tags": [
    "partial derivatives"
  ],
  "data": {
    "function": "x^3 y^2 + 4x y",
    "variables": [
      "x",
      "y"
    ],
    "respect": [
      "x"
    ]
  },
  "answer": "3x^2 y^2 + 4y",
  "mistakes": [],
  "hints": [
    "Treat y exactly like a constant number, then differentiate in x."
  ],
  "solution": [
    "Holding $y$ constant, $\\frac{\\partial}{\\partial x}(x^3y^2) = 3x^2y^2$ and $\\frac{\\partial}{\\partial x}(4xy) = 4y$.",
    "So $f_x = 3x^2y^2 + 4y$."
  ],
  "reference": {
    "book": "openstax-calc3",
    "section": "4.3 Partial Derivatives",
    "note": "Original problem."
  },
  "review": {
    "status": "draft"
  },
