  "kind": "directional_derivative",
  "title": "Directional derivative",
  "prompt": "Find the directional derivative of $f(x, y) = x^2 + 3xy$ at $(1, 2)$ in the direction of $\\mathbf{v} = \\langle 3, 4\\rangle$.",
  "answer_format": "An exact number.",
  "difficulty": 2,
  "tags": [
    "directional derivative",
    "gradient"
  ],
  "data": {
    "function": "x^2 + 3x y",
    "variables": [
      "x",
      "y"
    ],
    "at": [
      "1",
      "2"
    ],
    "direction": [
      "3",
      "4"
    ]
  },
  "answer": "36/5",
  "mistakes": [],
  "hints": [
    "D_u f = ∇f · u, where u is a UNIT vector.",
    "|⟨3, 4⟩| = 5."
  ],
  "solution": [
    "$\\nabla f = \\langle 2x + 3y,\\ 3x\\rangle$, so $\\nabla f(1, 2) = \\langle 8, 3\\rangle$.",
    "$\\mathbf{u} = \\frac{\\mathbf{v}}{|\\mathbf{v}|} = \\langle \\tfrac{3}{5}, \\tfrac{4}{5}\\rangle$.",
    "$D_{\\mathbf{u}}f = 8\\cdot\\tfrac{3}{5} + 3\\cdot\\tfrac{4}{5} = \\tfrac{36}{5}$."
  ],
  "reference": {
    "book": "openstax-calc3",
    "section": "4.6 Directional Derivatives and the Gradient",
    "note": "Original problem."
  },
  "review": {
    "status": "draft"
  },
